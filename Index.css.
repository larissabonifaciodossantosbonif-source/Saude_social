:root {
    --bg: #eef7ff;
    --bg-strong: #e0f2fe;
    --card: rgba(255, 255, 255, 0.92);
    --card-strong: #ffffff;
    --brand: #0ea5e9;
    --brand-dark: #0369a1;
    --brand-deep: #0f4c81;
    --text: #123b5c;
    --muted: #5c7288;
    --line: rgba(14, 165, 233, 0.12);
    --success: #10b981;
    --warning: #f59e0b;
    --danger: #ef4444;
    --shadow: 0 18px 45px rgba(15, 76, 129, 0.12);
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: 'Plus Jakarta Sans', sans-serif;
    background:
        radial-gradient(circle at top left, rgba(14, 165, 233, 0.12), transparent 35%),
        linear-gradient(180deg, #f8fbff 0%, #edf6ff 100%);
    color: var(--text);
}

a {
    text-decoration: none;
}

img {
    max-width: 100%;
    display: block;
}

button, input {
    font: inherit;
}

.container {
    width: min(1200px, calc(100% - 32px));
    margin: 0 auto;
}

.site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(14px);
    background: rgba(255, 255, 255, 0.78);
    border-bottom: 1px solid rgba(14, 165, 233, 0.1);
    box-shadow: 0 10px 30px rgba(15, 76, 129, 0.04);
}

.header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 88px;
}

.brand-wrap {
    display: flex;
    align-items: center;
    gap: 14px;
}

.brand-icon {
    width: 52px;
    height: 52px;
    border-radius: 18px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #0ea5e9, #0369a1);
    color: #fff;
    box-shadow: 0 16px 28px rgba(2, 132, 199, 0.25);
    font-size: 1.4rem;
}

.brand-wrap h1 {
    margin: 0;
    font-size: clamp(1.4rem, 2vw, 2rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
}

.brand-wrap h1 span {
    color: var(--brand);
}

.brand-wrap p {
    margin: 4px 0 0;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-dark);
    font-weight: 700;
}

.menu-desktop {
    display: flex;
    align-items: center;
    gap: 28px;
}

.menu-desktop a {
    color: var(--muted);
    font-size: 0.94rem;
    font-weight: 600;
    transition: color 0.2s ease;
}

.menu-desktop a:hover {
    color: var(--brand-dark);
}

.emergency-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0.9rem 1.3rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #ef4444, #dc2626);
    color: #fff;
    font-weight: 700;
    box-shadow: 0 16px 26px rgba(239, 68, 68, 0.28);
    transition: transform 0.2s ease;
}

.emergency-btn:hover {
    transform: translateY(-1px);
}

.hero {
    padding: 64px 0 32px;
}

.hero-inner {
    display: grid;
    grid-template-columns: 1.4fr 0.9fr;
    gap: 32px;
    align-items: center;
}

.hero-copy {
    background: rgba(255, 255, 255, 0.5);
    border: 1px solid var(--line);
    border-radius: 32px;
    padding: 34px;
    box-shadow: var(--shadow);
}

.eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.7rem 1rem;
    background: rgba(14, 165, 233, 0.1);
    border: 1px solid rgba(14, 165, 233, 0.15);
    border-radius: 999px;
    color: var(--brand-dark);
    font-size: 0.74rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

.eyebrow.dark {
    background: rgba(15, 76, 129, 0.08);
    border-color: rgba(15, 76, 129, 0.08);
    color: var(--brand-deep);
}

.hero-copy h2 {
    margin: 20px 0 14px;
    font-size: clamp(2.3rem, 5vw, 4.4rem);
    line-height: 1.02;
    letter-spacing: -0.06em;
    color: var(--brand-deep);
}

.hero-copy p {
    margin: 0;
    max-width: 650px;
    font-size: 1.06rem;
    line-height: 1.8;
    color: var(--muted);
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 28px;
}

.btn-primary, .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95rem 1.4rem;
    border-radius: 16px;
    font-weight: 700;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.btn-primary {
    color: #fff;
    background: linear-gradient(135deg, var(--brand), var(--brand-dark));
    box-shadow: 0 18px 30px rgba(2, 132, 199, 0.25);
}

.btn-secondary {
    color: var(--brand-deep);
    background: rgba(14, 165, 233, 0.08);
    border: 1px solid rgba(14, 165, 233, 0.16);
}

.btn-primary:hover, .btn-secondary:hover {
    transform: translateY(-2px);
}

.geo-status {
    margin-top: 30px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding: 1rem 1.1rem;
    border-radius: 18px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.92);
    color: var(--brand-deep);
    font-weight: 600;
}

.geo-status i {
    font-size: 1.1rem;
}

.geo-status button {
    margin-left: auto;
    border: none;
    border-radius: 12px;
    padding: 0.72rem 1rem;
    background: var(--brand);
    color: #fff;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.2s ease;
}

.geo-status button:hover {
    opacity: 0.96;
}

.geo-status.is-info {
    border-color: rgba(14, 165, 233, 0.2);
    background: rgba(14, 165, 233, 0.05);
}

.geo-status.is-success {
    border-color: rgba(16, 185, 129, 0.25);
    background: rgba(16, 185, 129, 0.08);
}

.geo-status.is-warning {
    border-color: rgba(245, 158, 11, 0.28);
    background: rgba(245, 158, 11, 0.08);
}

.hero-panel {
    display: grid;
    gap: 18px;
}

.panel-card {
    background: linear-gradient(180deg, rgba(255,255,255,0.94), rgba(224,242,254,0.82));
    border: 1px solid var(--line);
    border-radius: 28px;
    padding: 22px 24px;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.panel-card.highlight {
    background: linear-gradient(135deg, rgba(2,132,199,0.12), rgba(14, 165, 233, 0.02));
    border-color: rgba(14, 165, 233, 0.18);
}

.label {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-dark);
}

.panel-card strong {
    font-size: clamp(1.6rem, 2vw, 2.4rem);
    letter-spacing: -0.05em;
    color: var(--brand-deep);
}

.panel-card small {
    color: var(--muted);
    font-size: 0.82rem;
}

.services {
    padding: 10px 0 0;
}

.services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
}

.service-card {
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid var(--line);
    border-radius: 26px;
    padding: 24px;
    box-shadow: 0 14px 28px rgba(15, 76, 129, 0.06);
}

.icon-box {
    width: 58px;
    height: 58px;
    border-radius: 18px;
    display: grid;
    place-items: center;
    font-size: 1.5rem;
    margin-bottom: 20px;
    color: #fff;
}

.icon-box.blue {
    background: linear-gradient(135deg, #0ea5e9, #0369a1);
}

.icon-box.green {
    background: linear-gradient(135deg, #34d399, #10b981);
}

.icon-box.orange {
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
}

.service-card h3 {
    margin: 0 0 10px;
    font-size: 1.2rem;
    color: var(--brand-deep);
}

.service-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
}

.section-block {
    padding: 94px 0 0;
}

.section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
}

.section-heading h3 {
    margin: 12px 0 0;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    letter-spacing: -0.05em;
    color: var(--brand-deep);
}

.toolbar-panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    background: rgba(255,255,255,0.9);
    border: 1px solid var(--line);
    border-radius: 28px;
    padding: 22px;
    box-shadow: 0 16px 30px rgba(15, 76, 129, 0.06);
}

.search-wrap {
    position: relative;
    flex: 1 1 320px;
}

.search-wrap i {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
}

.search-wrap input {
    width: 100%;
    height: 58px;
    border-radius: 18px;
    border: 1px solid rgba(15, 76, 129, 0.12);
    background: #f8fbff;
    padding: 0 18px 0 46px;
    color: var(--text);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.search-wrap input:focus {
    border-color: rgba(14, 165, 233, 0.45);
    box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.12);
}

.filter-group {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.filter-btn {
    border: none;
    border-radius: 12px;
    background: #edf6ff;
    color: var(--muted);
    font-weight: 700;
    padding: 0.8rem 1rem;
    cursor: pointer;
    transition: all 0.2s ease;
}

.filter-btn.active {
    background: linear-gradient(135deg, var(--brand), var(--brand-dark));
    color: #fff;
    box-shadow: 0 12px 22px rgba(2,132,199,0.18);
}

.places-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    margin-top: 30px;
}

.place-card {
    background: rgba(255,255,255,0.94);
    border: 1px solid var(--line);
    border-radius: 26px;
    padding: 22px;
    box-shadow: 0 14px 28px rgba(15, 76, 129, 0.06);
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.place-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.place-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    background: rgba(14, 165, 233, 0.12);
    color: var(--brand-dark);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.status-badge {
    display: inline-flex;
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 800;
}

.status-success {
    background: rgba(16, 185, 129, 0.12);
    color: #047857;
}

.status-warning {
    background: rgba(245, 158, 11, 0.12);
    color: #b45309;
}

.place-card h4 {
    margin: 0;
    font-size: 1.3rem;
    line-height: 1.35;
    color: var(--brand-deep);
}

.place-address, .place-distance {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.6;
}

.place-distance {
    color: var(--brand-dark);
    font-weight: 700;
}

.specialties {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.specialties span {
    background: #f0f9ff;
    border: 1px solid rgba(14, 165, 233, 0.12);
    color: var(--brand-deep);
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
}

.place-actions {
    display: flex;
    gap: 10px;
    margin-top: auto;
}

.place-actions a {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1rem;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--brand), var(--brand-dark));
    color: #fff;
    font-weight: 800;
    transition: transform 0.2s ease;
}

.place-actions a.secondary {
    background: rgba(14,165,233,0.1);
    color: var(--brand-deep);
}

.place-actions a:hover {
    transform: translateY(-1px);
}

.empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 60px 20px;
    background: rgba(255,255,255,0.7);
    border: 1px solid var(--line);
    border-radius: 26px;
    color: var(--muted);
}

.empty-state i {
    font-size: 2rem;
    color: var(--brand);
    margin-bottom: 12px;
}

.empty-state h4 {
    margin: 0 0 10px;
    color: var(--brand-deep);
    font-size: 1.4rem;
}

.triage-block {
    padding-top: 96px;
}

.triage-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 24px;
}

.symptom-btn {
    border: 1px solid rgba(14, 165, 233, 0.16);
    background: #fff;
    color: var(--brand-deep);
    padding: 1rem 1.1rem;
    border-radius: 18px;
    text-align: left;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.symptom-btn:hover {
    transform: translateY(-2px);
    border-color: rgba(14,165,233,0.3);
    box-shadow: 0 14px 26px rgba(2,132,199,0.08);
}

.triage-result {
    margin-top: 24px;
    background: linear-gradient(180deg, rgba(239,246,255,0.95), rgba(255,255,255,0.95));
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 24px;
}

.triage-result strong {
    display: block;
    margin-bottom: 8px;
    font-size: 1.2rem;
    color: var(--brand-deep);
}

.triage-result p {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
}

.emergency-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 24px;
}

.emergency-card {
    background: rgba(255,255,255,0.9);
    border: 1px solid var(--line);
    border-radius: 26px;
    padding: 22px;
    display: flex;
    align-items: flex-start;
    gap: 18px;
    box-shadow: 0 16px 30px rgba(15, 76, 129, 0.05);
}

.emergency-card.danger {
    border-color: rgba(239, 68, 68, 0.25);
    background: rgba(254, 242, 242, 0.9);
}

.emergency-icon {
    min-width: 56px;
    width: 56px;
    height: 56px;
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(14,165,233,0.2), rgba(2,132,199,0.1));
    color: var(--brand-deep);
    display: grid;
    place-items: center;
    font-size: 1.5rem;
}

.emergency-card.danger .emergency-icon {
    background: linear-gradient(135deg, rgba(239,68,68,0.16), rgba(239,68,68,0.08));
    color: #b91c1c;
}

.emergency-card span {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 8px;
}

.emergency-card strong {
    display: block;
    font-size: 1.35rem;
    color: var(--brand-deep);
    margin-bottom: 8px;
}

.emergency-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
}

.site-footer {
    margin-top: 100px;
    border-top: 1px solid rgba(15, 76, 129, 0.1);
    background: rgba(255,255,255,0.7);
}

.footer-inner {
    min-height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    color: var(--muted);
    font-size: 0.95rem;
}

.footer-inner a {
    color: var(--brand-dark);
    font-weight: 700;
}

@media (max-width: 980px) {
    .hero-inner,
    .services-grid,
    .places-grid,
    .triage-grid,
    .emergency-grid {
        grid-template-columns: 1fr 1fr;
    }

    .hero-inner {
        grid-template-columns: 1fr;
    }

    .hero-panel {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

@media (max-width: 760px) {
    .menu-desktop {
        display: none;
    }

    .header-inner {
        min-height: 76px;
    }

    .hero-copy {
        padding: 24px 18px;
    }

    .hero-copy h2 {
        font-size: 2.4rem;
    }

    .services-grid,
    .places-grid,
    .triage-grid,
    .emergency-grid,
    .hero-panel {
        grid-template-columns: 1fr;
    }

    .toolbar-panel {
        padding: 18px;
    }

    .filter-group {
        width: 100%;
    }

    .filter-btn {
        flex: 1 1 45%;
    }

    .footer-inner {
        flex-direction: column;
        justify-content: center;
        text-align: center;
        padding: 18px 0;
    }
}
